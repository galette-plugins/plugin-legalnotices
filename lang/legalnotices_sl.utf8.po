#: ../templates/default/legalnotices_page.html.twig:14
msgid "Edit this page"
msgstr "Uredite to stran"

#: ../templates/default/legalnotices_page.html.twig:22
msgid "Last update"
msgstr "Zadnja posodobitev"

#: ../templates/default/legalnotices_page.html.twig:26
msgid "This page has not been translated in your language"
msgstr "Ta stran ni bila prevedena v vaš jezik"

#: ../templates/default/legalnotices_pages.html.twig:12
msgid "Choose a page"
msgstr "Izberite stran"

#: ../templates/default/legalnotices_pages.html.twig:18
msgid "Language"
msgstr "Jezik"

